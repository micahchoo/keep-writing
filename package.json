{
  "name": "keep-writing",
  "version": "0.2.7",
  "description": "Obsidian plugin: the vault interviews its owner. Draws a question into the daily note, composes new ones from what the owner has written, and links every answer to what provoked it.",
  "license": "MIT",
  "main": "main.js",
  "private": true,
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "bun test",
    "lint": "eslint src --max-warnings 0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "bun-types": "^1.3.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "latest",
    "typescript": "^5.6.0"
  }
}
